# Runtime stage
APP_ENV=dev

# Database provider
APP_DATABASE_PROVIDER=supabase

# Auth bypass for current integration stage
AUTH_BYPASS_ENABLED=false
AUTH_BYPASS_USER_PHONE=18660396808
NEXT_PUBLIC_AUTH_BYPASS_ENABLED=false
NEXT_PUBLIC_AUTH_BYPASS_USER_PHONE=18660396808

# User auth token TTL in seconds. Default: 30 days (2592000 seconds)
USER_AUTH_TOKEN_TTL_SECONDS=2592000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Native WeChat OAuth
# Get these from WeChat Official Account platform
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# WeChat OAuth callback URL
WECHAT_OAUTH_CALLBACK_URL=https://your-landing-domain/auth/wechat/callback

# WeChat Mini Program login (server-side only)
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

# RAG chat service
# dev: APP_ENV=dev 时读取 RAG_CHAT_URL
# prod: APP_ENV=prod 时读取 NEXT_RAG_CHAT_URL
RAG_CHAT_URL=http://127.0.0.1:8003/chat
NEXT_RAG_CHAT_URL=
RAG_CHAT_TOP_K=6
RAG_CHAT_RETURN_DEBUG=true
RAG_CHAT_TIMEOUT_MS=120000
RAG_CHAT_MAX_TOKENS=2400
# 与税务 Agent 服务的 AGENT_API_KEY 保持一致，仅服务端读取。
TAX_AGENT_API_KEY=

# Tencent Cloud ASR for speech input. Server-side only; never expose with NEXT_PUBLIC_.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_ASR_REGION=ap-shanghai
TENCENT_ASR_ENGINE=16k_zh
TENCENT_ASR_FILTER_MODAL=2
# Optional temporary hotwords, format: 发票|10,增值税|10,企业所得税|10
TENCENT_ASR_HOTWORD_LIST=

# SMS provider
# dev | juhe
SMS_PROVIDER=dev

# Juhe SMS (模板：【天赋大业教育科技】您的验证码是#code#。如非本人操作，请忽略本短信)
JUHE_SMS_API_KEY=
JUHE_SMS_TPL_ID=
